[Unit]
Description=Hub de Gestão - relógio dos jobs
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# Sem o contêiner (antes do primeiro deploy), a rodada é pulada em vez de falhar.
ExecCondition=/usr/bin/docker inspect --type container hub-app
ExecStart=/usr/bin/docker exec hub-app node /app/scripts/cron-tick.mjs
TimeoutStartSec=5min
