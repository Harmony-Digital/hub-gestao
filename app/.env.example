# Hub de Gestão · variáveis de ambiente, sem valores.
# Desenvolvimento: copie para .env.local. Produção: os valores ficam só em
# /opt/hub-gestao/shared/.env.production na VPS (root, 0600). Detalhes: ../docs/credenciais.md

# Aplicação
NEXT_PUBLIC_APP_URL=
APP_VERSION=

# Supabase compartilhado da Harmony (schema proj_hub_gestao)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Segurança do Hub
HUB_API_KEY_PEPPER=
HUB_ENCRYPTION_KEY=
CRON_SECRET=

# Integrações
RESEND_API_KEY=
GITHUB_WEBHOOK_SECRET=
LLM_MONTHLY_BUDGET_USD=30

# Só para desenvolvimento local, como alternativa. Em produção, as chaves de IA
# são cadastradas na tela Agentes e guardadas cifradas no banco (decisão D5).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
