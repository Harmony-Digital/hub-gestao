# Hub de Gestão · variáveis de ambiente, sem valores.
# Desenvolvimento: copie para .env.local. Produção: os valores ficam só em
# /opt/hub-gestao/shared/.env.production na VPS (root, 0600). Detalhes: ../docs/credenciais.md

# Aplicação
NEXT_PUBLIC_APP_URL=
APP_VERSION=
LOG_LEVEL=

# Supabase compartilhado da Harmony (schema proj_hub_gestao)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Link de acesso por e-mail no login: "on" só depois de autorizar o retorno do Hub no GoTrue.
HUB_AUTH_MAGIC_LINK=

# Banco do servidor (M2). Sem DATABASE_URL, o desenvolvimento usa o banco local (PGlite).
DATABASE_URL=
HUB_DB_RUNTIME_ROLE=
HUB_WORKSPACE_SLUG=harmony
HUB_RATE_LIMIT_PER_MIN=600

# Segurança do Hub
HUB_API_KEY_PEPPER=
HUB_ENCRYPTION_KEY=
CRON_SECRET=

# Integrações
RESEND_API_KEY=
GITHUB_WEBHOOK_SECRET=
LLM_MONTHLY_BUDGET_USD=30

# As chaves de IA não ficam em variável: o dono cadastra cada uma na Sala de Controle
# (Chaves de IA) e elas ficam cifradas no banco com HUB_ENCRYPTION_KEY (decisão D5).

# Só para desenvolvimento local: banco PGlite e a chave do "Agente local de teste".
# Gere a chave no formato hub_ak_<12 letras ou números>.<segredo base64url de 43 caracteres>.
HUB_DATA_DIR=.data/pglite
HUB_DEV_AGENT_KEY=
# Login de teste sem senha e projeto de exemplo (EXE), só no banco local. O build de
# produção remove esse código; mesmo com estas variáveis, a produção ignora o login de teste.
HUB_DEV_LOGIN=
HUB_DEV_LOGIN_SECRET=
HUB_DEV_SAMPLE=
# Modelo de IA simulado (on), só no computador: as telas de IA funcionam sem chamar
# provedor (src/lib/llm/dev-fake.ts). O build de produção remove esse código.
HUB_DEV_FAKE_LLM=
